{
  "nodeModulesDir": "none",
  "tasks": {
    "dev": "deno run --allow-read --allow-write --allow-run --allow-net tools/dev.mjs",
    "build": "deno run --allow-read --allow-write --allow-run tools/build.mjs",
    "preview": "deno run --allow-read --allow-net tools/serve.mjs",
    "cf:deploy": "deno --allow-env --allow-run npm:wrangler deploy",
    "cf:dev": "deno npm:wrangler dev",
    "cf:start": "deno npm:wrangler dev",
    "cf:typegen": "deno npm:wrangler types",
    "matrix": "deno run --allow-read --allow-write src/cli/fullsize-matrix.mjs",
    "coords": "deno run --allow-read --allow-write src/cli/coordinates.mjs",
    "test": "deno test --allow-read test/"
  },
  "fmt": {
    "lineWidth": 100,
    "exclude": [
      "dist"
    ]
  },
  "lint": {
    "include": [
      "src",
      "test",
      "tools"
    ],
    "exclude": [
      "dist"
    ],
    "rules": {
      "exclude": [
        "no-import-prefix"
      ]
    }
  }
}
